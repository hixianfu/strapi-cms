{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": { "singularName": "contact-page", "pluralName": "contact-pages", "displayName": "Contact page", "description": "Manage contact information and form copy." },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 160 },
    "intro": { "type": "text", "maxLength": 1000 },
    "address": { "type": "text", "maxLength": 500 },
    "phone": { "type": "string", "maxLength": 80 },
    "email": { "type": "email" },
    "officeHours": { "type": "text", "maxLength": 500 },
    "mapEmbedUrl": { "type": "string", "maxLength": 1000 },
    "formTitle": { "type": "string", "maxLength": 160 },
    "formIntro": { "type": "text", "maxLength": 500 },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
