{
  "kind": "collectionType",
  "collectionName": "faq_categories",
  "info": {
    "singularName": "faq-category",
    "pluralName": "faq-categories",
    "displayName": "答疑分类",
    "description": "管理答疑解惑菜单分类。"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": {
      "displayName": "内容语言（contentLocale）", "type": "enumeration", "enum": ["zh", "en"], "default": "zh", "required": true
    },
    "name": { "displayName": "名称（name）", "type": "string", "required": true },
    "slug": { "displayName": "网址别名（slug）", "type": "uid", "targetField": "name", "required": true },
    "sortOrder": { "displayName": "排序（sortOrder）", "type": "integer", "default": 0, "min": 0 },
    "faqs": { "displayName": "答疑（faqs）", "type": "relation", "relation": "oneToMany", "target": "api::faq.faq", "mappedBy": "category" }
  }
}
