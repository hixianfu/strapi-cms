{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": { "singularName": "home-page", "pluralName": "home-pages", "displayName": "Home page", "description": "Manage homepage content." },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "heroSlides": { "type": "component", "repeatable": true, "required": true, "component": "shared.hero-slide", "min": 1, "max": 8 },
    "introTitle": { "type": "string", "maxLength": 160 },
    "intro": { "type": "text", "maxLength": 1000 },
    "featureSections": { "type": "component", "repeatable": true, "component": "shared.feature-list", "max": 6 },
    "featuredProductsTitle": { "type": "string", "maxLength": 160 },
    "featuredArticlesTitle": { "type": "string", "maxLength": 160 },
    "featuredProducts": { "type": "relation", "relation": "manyToMany", "target": "api::product.product" },
    "featuredArticles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article" },
    "featuredSolutions": { "type": "relation", "relation": "manyToMany", "target": "api::solution.solution" },
    "featuredScenarios": { "type": "relation", "relation": "manyToMany", "target": "api::scenario.scenario" },
    "featuredCases": { "type": "relation", "relation": "manyToMany", "target": "api::case-study.case-study" },
    "featuredVideos": { "type": "relation", "relation": "manyToMany", "target": "api::video.video" },
    "featuredFaqs": { "type": "relation", "relation": "manyToMany", "target": "api::faq.faq" },
    "cta": { "type": "component", "repeatable": false, "component": "shared.cta" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
