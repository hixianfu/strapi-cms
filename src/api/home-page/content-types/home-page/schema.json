{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "首页",
    "description": "管理网站首页内容。"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "introTitle": {
      "displayName": "介绍标题（introTitle）", "type": "string", "maxLength": 160 },
    "intro": {
      "displayName": "介绍内容（intro）", "type": "text", "maxLength": 1000 },
    "sections": {
      "displayName": "页面区块（sections）",
      "type": "dynamiczone",
      "components": [
        "shared.home-hero",
        "shared.home-products",
        "shared.home-articles",
        "shared.home-article-showcase",
        "shared.home-partners",
        "shared.home-why-choose-us",
        "shared.home-solutions",
        "shared.home-scenarios",
        "shared.home-cases",
        "shared.home-videos",
        "shared.home-faqs",
        "shared.home-feature-cards",
        "shared.home-company-showcase"
      ],
      "max": 12
    },
    "cta": {
      "displayName": "行动引导（cta）",
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "seo": {
      "displayName": "搜索引擎优化（seo）",
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
