{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "首页",
    "description": "Manage homepage content."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "introTitle": { "type": "string", "maxLength": 160 },
    "intro": { "type": "text", "maxLength": 1000 },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "shared.home-hero",
        "shared.home-products",
        "shared.home-articles",
        "shared.home-article-showcase",
        "shared.home-partners",
        "shared.home-why-choose-us",
        "shared.home-solutions",
        "shared.home-scenarios",
        "shared.home-cases",
        "shared.home-videos",
        "shared.home-faqs",
        "shared.home-feature-cards",
        "shared.home-company-showcase"
      ],
      "max": 12
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
