{
  "kind": "collectionType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "关于我们",
    "description": "管理关于我们页面内容。"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": {
      "displayName": "内容语言（contentLocale）",
      "type": "enumeration",
      "enum": ["zh", "en"],
      "default": "zh",
      "required": true
    },
    "title": {
      "displayName": "标题（title）",
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "cover": {
      "displayName": "封面图片（cover）", "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "coverAlt": {
      "displayName": "封面图片替代文本（coverAlt）", "type": "string", "maxLength": 160 },
    "blocks": {
      "displayName": "内容区块（blocks）",
      "type": "dynamiczone",
      "components": [
        "shared.media",
        "shared.quote",
        "shared.rich-text",
        "shared.slider",
        "shared.feature-list",
        "shared.timeline-item",
        "shared.media-gallery",
        "shared.cta"
      ]
    },
    "seo": {
      "displayName": "搜索引擎优化（seo）",
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
