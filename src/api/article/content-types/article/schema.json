{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "文章",
    "description": "管理博客文章内容。"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": {
      "displayName": "内容语言（contentLocale）",
      "type": "enumeration",
      "enum": ["zh", "en"],
      "default": "zh",
      "required": true
    },
    "title": {
      "displayName": "标题（title）",
      "type": "string"
    },
    "description": {
      "displayName": "描述（description）",
      "type": "text",
      "maxLength": 80
    },
    "slug": {
      "displayName": "网址别名（slug）",
      "type": "uid",
      "targetField": "title"
    },
    "cover": {
      "displayName": "封面图片（cover）",
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "author": {
      "displayName": "作者（author）",
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "category": {
      "displayName": "分类（category）",
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "products": {
      "displayName": "关联产品（products）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "articles"
    },
    "solutions": {
      "displayName": "关联解决方案（solutions）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution"
    },
    "scenarios": {
      "displayName": "关联应用场景（scenarios）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::scenario.scenario"
    },
    "cases": {
      "displayName": "关联客户案例（cases）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study"
    },
    "videos": {
      "displayName": "相关视频（videos）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::video.video"
    },
    "faqs": {
      "displayName": "相关常见问题（faqs）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "blocks": {
      "displayName": "内容区块（blocks）",
      "type": "dynamiczone",
      "components": [
        "shared.media",
        "shared.quote",
        "shared.rich-text",
        "shared.slider"
      ]
    }
  }
}
