{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": { "singularName": "faq", "pluralName": "faqs", "displayName": "FAQ", "description": "Frequently asked questions for products and solutions." },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": { "type": "enumeration", "enum": ["zh", "en"], "default": "zh", "required": true },
    "question": { "type": "string", "required": true, "maxLength": 300 },
    "slug": { "type": "uid", "targetField": "question", "required": true },
    "answer": { "type": "richtext", "required": true },
    "category": { "type": "enumeration", "enum": ["product", "solution", "usage", "service", "other"], "default": "product", "required": true },
    "products": { "type": "relation", "relation": "manyToMany", "target": "api::product.product" },
    "solutions": { "type": "relation", "relation": "manyToMany", "target": "api::solution.solution" },
    "sortOrder": { "type": "integer", "default": 0, "min": 0 },
    "featured": { "type": "boolean", "default": false },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
