{
  "kind": "collectionType",
  "collectionName": "videos",
  "info": { "singularName": "video", "pluralName": "videos", "displayName": "视频", "description": "视频中心内容，支持上传视频或使用外部视频链接。" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": {
      "displayName": "内容语言（contentLocale）", "type": "enumeration", "enum": ["zh", "en"], "default": "zh", "required": true },
    "title": {
      "displayName": "标题（title）", "type": "string", "required": true, "maxLength": 160 },
    "slug": {
      "displayName": "网址别名（slug）", "type": "uid", "targetField": "title", "required": true },
    "description": {
      "displayName": "描述（description）", "type": "text", "maxLength": 500 },
    "category": {
      "displayName": "分类（category）", "type": "relation", "relation": "manyToOne", "target": "api::video-category.video-category", "inversedBy": "videos", "required": true },
    "cover": {
      "displayName": "封面图片（cover）", "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "file": {
      "displayName": "文件（file）", "type": "media", "multiple": false, "allowedTypes": ["videos"] },
    "externalUrl": {
      "displayName": "外部链接（externalUrl）", "type": "string", "maxLength": 1000 },
    "products": {
      "displayName": "关联产品（products）", "type": "relation", "relation": "manyToMany", "target": "api::product.product" },
    "solutions": {
      "displayName": "关联解决方案（solutions）", "type": "relation", "relation": "manyToMany", "target": "api::solution.solution" },
    "scenarios": {
      "displayName": "关联应用场景（scenarios）", "type": "relation", "relation": "manyToMany", "target": "api::scenario.scenario" },
    "cases": {
      "displayName": "关联客户案例（cases）", "type": "relation", "relation": "manyToMany", "target": "api::case-study.case-study" },
    "articles": {
      "displayName": "相关文章（articles）", "type": "relation", "relation": "manyToMany", "target": "api::article.article" },
    "sortOrder": {
      "displayName": "排序（sortOrder）", "type": "integer", "default": 0, "min": 0 },
    "featured": {
      "displayName": "设为推荐（featured）", "type": "boolean", "default": false },
    "seo": {
      "displayName": "搜索引擎优化（seo）", "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
