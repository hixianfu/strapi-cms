{
  "kind": "collectionType",
  "collectionName": "case_categories",
  "info": {
    "singularName": "case-category",
    "pluralName": "case-categories",
    "displayName": "客户案例分类",
    "description": "将客户案例归类管理。"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "contentLocale": {
      "displayName": "内容语言（contentLocale）",
      "type": "enumeration",
      "enum": ["zh", "en"],
      "default": "zh",
      "required": true
    },
    "name": {
      "displayName": "名称（name）", "type": "string", "required": true, "maxLength": 120 },
    "slug": {
      "displayName": "网址别名（slug）", "type": "uid", "targetField": "name", "required": true },
    "description": {
      "displayName": "描述（description）", "type": "text", "maxLength": 500 },
    "sortOrder": {
      "displayName": "排序（sortOrder）", "type": "integer", "default": 0, "min": 0 },
    "cases": {
      "displayName": "关联客户案例（cases）",
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "category"
    }
  }
}
