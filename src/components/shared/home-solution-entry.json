{
  "collectionName": "components_shared_home_solution_entries",
  "info": { "displayName": "首页方案条目", "icon": "layers" },
  "options": {},
  "attributes": {
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::solution-category.solution-category",
      "required": true
    },
    "title": { "type": "string", "maxLength": 160 },
    "description": { "type": "text", "maxLength": 600 },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "imageAlt": { "type": "string", "maxLength": 160 },
    "solutions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution"
    }
  }
}
