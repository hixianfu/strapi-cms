      "relation": "manyToOne",
      "target": "api::solution-category.solution-category",
      "required": true
    },
    "title": {
      "displayName": "标题（title）", "type": "string", "maxLength": 160 },
    "description": {
      "displayName": "描述（description）", "type": "text", "maxLength": 600 },
    "backgroundImage": {
      "displayName": "背景图片（backgroundImage）",
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "displayName": "图片替代文本（imageAlt）", "type": "string", "maxLength": 160 },
    "solutions": {
      "displayName": "关联解决方案（solutions）",
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution"
    }
  }
