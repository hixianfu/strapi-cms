{
  "collectionName": "components_shared_home_company_showcases",
  "info": { "displayName": "首页公司展示", "icon": "building" },
  "options": {},
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 160 },
    "subtitle": { "type": "string", "maxLength": 240 },
    "description": { "type": "text", "maxLength": 1200 },
    "buttonLabel": { "type": "string", "required": true, "maxLength": 80 },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "imageAlt": { "type": "string", "maxLength": 160 },
    "article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article"
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.home-showcase-highlight",
      "min": 1,
      "max": 6
    }
  }
}
